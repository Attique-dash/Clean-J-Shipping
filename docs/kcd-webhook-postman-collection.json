      "name": "1. Test Webhook - Valid Payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "XoZedblJE0neONu5EvN3CE2xGkOw9ggwCSysjrGpjF2S2KqY"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"trackingNumber\": \"TBA3295097\",\n  \"houseNumber\": \"CLEAN0000001\",\n  \"customerMailbox\": \"CLEAN-0007\",\n  \"weight\": \"2.5\",\n  \"shipper\": \"Amazon\",\n  \"receivedAt\": \"2026-03-23T10:12:00Z\"\n}"
        },
        "url": {
          "raw": "https://cleanjshipping.vercel.app/api/kcd/packages/add",
          "protocol": "https",
          "host": [
            "cleanjshipping",
            "vercel",
            "app"
          ],
          "path": [
            "api",
            "kcd",
            "packages",
            "add"
          ]
        },
        "description": "Test the webhook with a valid payload. Should return 201 Created."
      }
    },
